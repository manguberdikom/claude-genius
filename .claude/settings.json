{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(tools/doc.sh:*)",
      "Bash(./tools/doc.sh:*)",
      "Bash(bash tools/doc.sh:*)",
      "Bash(python3 tools/build_index.py:*)",
      "Bash(python3 tools/check_docs.py:*)",
      "Bash(python3 tools/build_single.py:*)",
      "Bash(python3 tools/schema_from_entities.py:*)",
      "Bash(python3 tools/test_guard.py:*)",
      "Bash(python3 tools/test_suggest.py:*)",
      "Bash(python3 tools/test_schema.py:*)",
      "Bash(python3 tools/eval_find.py:*)",
      "Bash(python3 tools/cost_report.py:*)",
      "Bash(python3 tools/parse_test_output.py:*)",
      "Bash(python3 tools/check_code.py:*)",
      "Bash(python3 tools/test_doc.py:*)",
      "Bash(python3 tools/test_check_code.py:*)",
      "Bash(python3 tools/test_parse_test_output.py:*)",
      "Bash(python3 tools/test_skill.py:*)",
      "Bash(python3 tools/rules_for.py:*)",
      "Bash(python3 tools/test_rules_for.py:*)",
      "Bash(python3 tools/eval_skill.py:*)",
      "Bash(python3 tools/budget.py:*)",
      "Bash(python3 tools/usage.py:*)",
      "Bash(python3 tools/test_usage.py:*)",
      "Bash(python3 tools/test_rewrite_paths.py:*)",
      "Bash(python3 tools/test_merge_settings.py:*)",
      "Bash(python3 install/rewrite_paths.py:*)",
      "Bash(python3 tools/test_budget.py:*)",
      "Bash(python3 tools/handoff.py:*)",
      "Bash(python3 tools/test_handoff.py:*)",
      "Bash(python3 tools/tozala.py:*)",
      "Bash(python3 tools/test_tozala.py:*)",
      "Bash(python3 tools/sonar_local.py:*)",
      "Bash(python3 tools/test_sonar_local.py:*)",
      "Bash(python3 tools/code_gap.py:*)",
      "Bash(python3 tools/add_code.py:*)",
      "Bash(python3 tools/test_add_code.py:*)",
      "Bash(xargs -0 python3 tools/check_code.py:*)",
      "Bash(xargs python3 tools/check_code.py:*)",
      "Bash(grep:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(wc:*)",
      "Read",
      "Grep",
      "Glob"
    ]
  },
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PROJECT_DIR}/tools/suggest_sections.py\" || exit 1",
            "timeout": 10,
            "statusMessage": "Mos bo'limlar qidirilmoqda"
          },
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PROJECT_DIR}/tools/budget.py\" || exit 1",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PROJECT_DIR}/tools/handoff.py\" --hook || exit 1",
            "timeout": 10,
            "statusMessage": "Kontekst o'lchanmoqda"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Read|Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PROJECT_DIR}/tools/guard.py\" || exit 1",
            "timeout": 10,
            "statusMessage": "Qimmat amal tekshirilmoqda"
          }
        ]
      },
      {
        "matcher": "Task|Agent|SendMessage",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PROJECT_DIR}/tools/budget.py\" || exit 1",
            "timeout": 10,
            "statusMessage": "Aktyor budjeti tekshirilmoqda"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PROJECT_DIR}/tools/actor_check.py\" || exit 1",
            "timeout": 10,
            "statusMessage": "Aktyor natijasi tekshirilmoqda"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PROJECT_DIR}/tools/usage.py\" --saqlash || exit 1",
            "timeout": 20,
            "statusMessage": "Token sarfi yozilmoqda"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PROJECT_DIR}/tools/check_code.py\" || exit 1",
            "timeout": 15,
            "statusMessage": "Java qoidalari tekshirilmoqda"
          }
        ]
      }
    ]
  }
}
