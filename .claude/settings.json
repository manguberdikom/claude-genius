{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(tools/doc.sh:*)",
      "Bash(./tools/doc.sh:*)",
      "Bash(bash tools/doc.sh:*)",
      "Bash(python3 tools/build_index.py:*)",
      "Bash(python3 tools/check_docs.py:*)",
      "Bash(python3 tools/build_single.py:*)",
      "Bash(python3 tools/schema_from_entities.py:*)",
      "Bash(python3 tools/test_guard.py:*)",
      "Bash(python3 tools/test_suggest.py:*)",
      "Bash(python3 tools/test_schema.py:*)",
      "Bash(python3 tools/eval_find.py:*)",
      "Bash(python3 tools/cost_report.py:*)",
      "Bash(python3 tools/parse_test_output.py:*)",
      "Bash(python3 tools/check_code.py:*)",
      "Bash(python3 tools/test_doc.py:*)",
      "Bash(python3 tools/test_check_code.py:*)",
      "Bash(python3 tools/test_parse_test_output.py:*)",
      "Bash(python3 tools/test_skill.py:*)",
      "Bash(python3 tools/rules_for.py:*)",
      "Bash(python3 tools/test_rules_for.py:*)",
      "Bash(python3 tools/eval_skill.py:*)",
      "Bash(python3 tools/budget.py:*)",
      "Bash(python3 tools/usage.py:*)",
      "Bash(python3 tools/test_usage.py:*)",
      "Bash(python3 tools/test_rewrite_paths.py:*)",
      "Bash(python3 install/rewrite_paths.py:*)",
      "Bash(python3 tools/test_budget.py:*)",
      "Bash(python3 tools/handoff.py:*)",
      "Bash(python3 tools/test_handoff.py:*)",
      "Bash(python3 tools/code_gap.py:*)",
      "Bash(python3 tools/add_code.py:*)",
      "Bash(python3 tools/test_add_code.py:*)",
      "Bash(sed -n:*)",
      "Bash(grep:*)",
      "Bash(awk:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(wc:*)",
      "Read",
      "Grep",
      "Glob"
    ]
  },
  "bashOutputMaxChars": 12000,
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/tools/suggest_sections.py\"",
            "timeout": 10,
            "statusMessage": "Mos bo'limlar qidirilmoqda"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Read|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/tools/guard.py\"",
            "timeout": 10,
            "statusMessage": "Qimmat amal tekshirilmoqda"
          }
        ]
      },
      {
        "matcher": "Task|Agent",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/tools/budget.py\"",
            "timeout": 10,
            "statusMessage": "Aktyor budjeti tekshirilmoqda"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/tools/usage.py\" --saqlash",
            "timeout": 20,
            "statusMessage": "Token sarfi yozilmoqda"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/tools/check_code.py\"",
            "timeout": 15,
            "statusMessage": "Java qoidalari tekshirilmoqda"
          }
        ]
      }
    ]
  }
}
