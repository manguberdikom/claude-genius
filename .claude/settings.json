{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(tools/doc.sh:*)",
      "Bash(./tools/doc.sh:*)",
      "Bash(bash tools/doc.sh:*)",
      "Bash(python3 tools/build_index.py:*)",
      "Bash(python3 tools/check_docs.py:*)",
      "Bash(python3 tools/build_single.py:*)",
      "Bash(python3 tools/test_guard.py:*)",
      "Bash(sed -n:*)",
      "Bash(grep:*)",
      "Bash(awk:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(wc:*)",
      "Read",
      "Grep",
      "Glob"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Read|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/tools/guard_bigdocs.py\"",
            "timeout": 10,
            "statusMessage": "Fayl hajmi tekshirilmoqda"
          }
        ]
      }
    ]
  }
}
